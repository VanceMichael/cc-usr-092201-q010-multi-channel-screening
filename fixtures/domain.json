    {"event": "开场前退票", "affects": ["座席占用释放"], "never_affects": ["授权计数（权利按实际播放核销）"]},
    {"event": "放映结束核销", "affects": ["放映回执", "授权锁定转已消耗", "版权方对账记录"], "never_affects": ["其他场次"]}
