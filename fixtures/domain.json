  "workflow_states": [
    "待适配",
    "已排片",
    "可开放",
    "需调整",
    "放映中",
    "已核销",
    "已取消"
  ],
  "state_transitions": [
    {"from": "待适配", "to": "已排片", "trigger": "母版/字幕/设备/授权/场地/嘉宾全部校验通过，确认时原子锁定授权次数与场馆时段"},
    {"from": "已排片", "to": "可开放", "trigger": "分级提示已绑定、无阻塞性适配问题、发布名额=可售+免费=场馆容量"},
    {"from": "可开放", "to": "需调整", "trigger": "母版校验失败/换厅/授权变更等，暂停售票"},
    {"from": "已排片", "to": "需调整", "trigger": "映前技术核查发现阻塞问题"},
    {"from": "需调整", "to": "已排片", "trigger": "问题解决并重新通过全部校验"},
    {"from": "可开放", "to": "放映中", "trigger": "实际开场"},
    {"from": "需调整", "to": "已取消", "trigger": "户外取消等，释放锁定资源"},
    {"from": "可开放", "to": "已取消", "trigger": "开场前取消（含户外天气取消），释放授权锁定与场地，已售票自动退票"},
    {"from": "放映中", "to": "已核销", "trigger": "回执核对实际播放母版、观众容量与权利消耗"},
    {"from": "已排片", "to": "已取消", "trigger": "开场前取消，释放授权锁定与场地，已售票全额退回"}
  ],
  "facts": [
    "电影节设置影院、线上、户外和校园四类放映板块",
    "活动计划展映四百余部影片",
    "部分场次面向公众提供惠民免费座席",
    "影片授权按渠道、地域、时段窗口和场次次数四个维度发放，例如仅允许线下两场",
    "母版按格式声明所需播放设备能力，部分母版无法在户外设备播放",
    "场次必须在确认排期的同一事务内锁定授权次数与场馆时段，二者同时成功或都不生效",
    "母版适配问题在排片入口即校验并分派技术组，不等到开场前暴露",
    "字幕与分级提示是开放售票前的必备条件",
    "对外发布的名额始终等于可售名额加惠民免费名额，且不超过场馆容量或线上限流",
    "母版校验失败、嘉宾改期、户外取消、线上地域限制、换厅、退票只牵动相关记录",
    "任何重排都必须重新通过授权四维校验，已消耗与已锁定之和不得超过授权次数",
    "户外场次因天气取消时释放其锁定的授权次数与场地，并对已售票自动退票",
    "线上场次的观众地域限制以授权为准，超出地域的订单不得成交",
    "开场前退票只释放座席占用，不改变权利计数；权利以实际播放逐场核销",
    "放映结束后向版权方逐场提供实际播放母版、观众容量与已消耗权利的核对回执"
  ],
  "invariants": [
    {"code": "INV-01", "name": "授权次数上限", "rule": "同一授权维度下，已锁定场次数与回执已核销场次数之和不超过 max_screenings"},
    {"code": "INV-02", "name": "渠道授权", "rule": "场次渠道必须属于授权条款许可的渠道集合，线下限定的影片不得排入线上"},
    {"code": "INV-03", "name": "地域授权", "rule": "线下场次举办地域与线上场次观众地域均须被授权地域覆盖，境外永不覆盖"},
    {"code": "INV-04", "name": "时段窗口", "rule": "场次起止时间必须完全落在授权窗口内"},
    {"code": "INV-05", "name": "母版设备适配", "rule": "母版 requires_equipment 必须是场地设备能力的子集；不满足时不创建锁定并生成技术适配问题"},
    {"code": "INV-06", "name": "字幕齐备", "rule": "场次要求的字幕语种必须存在于所选母版的字幕清单"},
    {"code": "INV-07", "name": "分级提示", "rule": "开放发布前影片必须绑定分级标签与提示语"},
    {"code": "INV-08", "name": "场地时段唯一", "rule": "同一场地（或线上展映厅）的未取消场次时段不得重叠"},
    {"code": "INV-09", "name": "嘉宾不撞期", "rule": "同一嘉宾关联场次的时段（含30分钟转场缓冲）不得重叠"},
    {"code": "INV-10", "name": "发布名额一致", "rule": "发布总名额=可售名额+惠民免费名额=场馆容量或线上限流；已售/已约不超过可售名额"},
    {"code": "INV-11", "name": "确认原子性", "rule": "确认场次同时锁定一次授权次数与一个场馆时段，任一校验失败则全部不生效"},
    {"code": "INV-12", "name": "最小牵动", "rule": "变更只影响其直接关联记录；其他渠道、其他影片、其他场次的锁定与名额保持不变"},
    {"code": "INV-13", "name": "重排不破权", "rule": "改期、换厅、替换母版后仍须通过 INV-01 至 INV-09，授权次数不因重排被重复占用或突破"},
    {"code": "INV-14", "name": "回执核销", "rule": "已核销场次必须有回执：实际播放母版可核对、观众数不超过容量、权利按一场消耗，版权方可逐场核对"}
  ],
  "change_events": [
